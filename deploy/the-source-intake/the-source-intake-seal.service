[Unit]
Description=Seal and sign the waiting room's daily batch (KEI-932)

[Service]
Type=oneshot
User=the-source-intake
Group=the-source-intake
WorkingDirectory=/opt/the-source-intake/app
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=THE_SOURCE_ROOT=/var/lib/the-source-intake/repo
# The signing key is root-owned 0600; systemd hands it to this unit only, never to the server.
LoadCredential=signing_key:/etc/the-source-intake/signing_key
ExecStart=/bin/sh -c 'exec /usr/bin/python3 -s -m source_pipeline waiting-room seal --state /var/lib/the-source-intake/state --key "$CREDENTIALS_DIRECTORY/signing_key"'
StateDirectory=the-source-intake
UMask=0027
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadOnlyPaths=/opt/the-source-intake
